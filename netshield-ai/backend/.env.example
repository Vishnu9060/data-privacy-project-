# NetShield AI backend configuration
#
# Copy this file to ".env" and fill in your values:
#     cp .env.example .env
#
# The .env file is git-ignored, so your real key is never committed.

# --- Groq AI report summary ---
# Get a key from https://console.groq.com  (API Keys). Groq keys start with "gsk_".
# When set, the Security Report's summary is written by a Groq-hosted LLM. When
# empty or absent, the report automatically falls back to a built-in offline
# summary, so the app works fine without a key too.
GROQ_API_KEY=

# Optional: override the Groq model (default: llama-3.3-70b-versatile).
# See https://console.groq.com/docs/models for current model IDs.
GROQ_MODEL=llama-3.3-70b-versatile
